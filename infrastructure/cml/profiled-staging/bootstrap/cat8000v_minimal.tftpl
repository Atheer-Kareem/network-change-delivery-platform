hostname ${hostname}
ip domain name ncdp.local
username ${username} privilege 15 secret 9 ${password_hash}
interface GigabitEthernet1
 ip address ${split("/", management_cidr)[0]} ${cidrnetmask(management_cidr)}
 no shutdown
ip ssh version 2
crypto key generate rsa modulus 2048
line vty 0 4
 login local
 transport input ssh
end
